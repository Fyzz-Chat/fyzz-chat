{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFormation template for deploying Fyzz Chat to ECS on EC2",
  "Parameters": {
    "BetterAuthSecretArn": {
      "Type": "String",
      "Description": "Full ARN of the Secrets Manager secret containing BETTER_AUTH_SECRET"
    },
    "OpenaiApiKeySecretArn": {
      "Type": "String",
      "Description": "Full ARN of the Secrets Manager secret containing OPENAI_API_KEY"
    },
    "BetterAuthUrl": {
      "Type": "String",
      "Description": "The URL of your application (e.g., https://app.example.com)"
    },
    "ImageUri": {
      "Type": "String",
      "Description": "GHCR image URI",
      "Default": "ghcr.io/fyzz-chat/fyzz-chat:latest"
    },
    "VpcCidr": {
      "Type": "String",
      "Description": "CIDR block for VPC",
      "Default": "10.0.0.0/16"
    },
    "DBInstanceClass": {
      "Type": "String",
      "Description": "RDS instance class",
      "Default": "db.t4g.micro",
      "AllowedValues": ["db.t4g.micro", "db.t4g.small", "db.t4g.medium", "db.t4g.large", "db.t3.micro", "db.t3.small", "db.t3.medium", "db.t3.large"]
    },
    "DBAllocatedStorage": {
      "Type": "Number",
      "Description": "Allocated storage for RDS instance in GB",
      "Default": 20,
      "MinValue": 20,
      "MaxValue": 65536
    },
    "Environment": {
      "Type": "String",
      "Description": "Environment name",
      "Default": "production",
      "AllowedValues": ["development", "staging", "production"]
    },
    "DesiredTaskCount": {
      "Type": "Number",
      "Description": "Number of ECS tasks to run",
      "Default": 1,
      "MinValue": 1
    },
    "MinCapacity": {
      "Type": "Number",
      "Description": "Minimum number of EC2 instances",
      "Default": 1,
      "MinValue": 1
    },
    "MaxCapacity": {
      "Type": "Number",
      "Description": "Maximum number of EC2 instances",
      "Default": 2,
      "MinValue": 1
    },
    "TaskCpu": {
      "Type": "Number",
      "Description": "CPU units per task",
      "Default": 512,
      "AllowedValues": [256, 512, 1024, 2048, 4096]
    },
    "TaskMemory": {
      "Type": "Number",
      "Description": "Memory per task in MB",
      "Default": 1024,
      "AllowedValues": [512, 1024, 2048, 3072, 4096, 5120, 6144, 7168, 8192]
    },
    "CertificateArn": {
      "Type": "String",
      "Description": "ACM certificate ARN for HTTPS (optional)",
      "Default": ""
    },
    "InstanceType": {
      "Type": "String",
      "Description": "EC2 instance type",
      "Default": "t3.medium",
      "AllowedValues": ["t3.small", "t3.medium", "t3.large", "t3.xlarge", "t4g.medium", "t4g.large"]
    }
  },
  "Conditions": {
    "HasCertificate": {
      "Fn::Not": [{"Fn::Equals": [{"Ref": "CertificateArn"}, ""]}]
    }
  },
  "Resources": {
    "VPC": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": {"Ref": "VpcCidr"},
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-vpc"}]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-igw"}]
      }
    },
    "AttachGateway": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {"Ref": "VPC"},
        "InternetGatewayId": {"Ref": "InternetGateway"}
      }
    },
    "PublicSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {"Ref": "VPC"},
        "CidrBlock": "10.0.1.0/24",
        "AvailabilityZone": {"Fn::Select": [0, {"Fn::GetAZs": ""}]},
        "MapPublicIpOnLaunch": true,
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-public-subnet-1"}]
      }
    },
    "PublicSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {"Ref": "VPC"},
        "CidrBlock": "10.0.2.0/24",
        "AvailabilityZone": {"Fn::Select": [1, {"Fn::GetAZs": ""}]},
        "MapPublicIpOnLaunch": true,
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-public-subnet-2"}]
      }
    },
    "PrivateSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {"Ref": "VPC"},
        "CidrBlock": "10.0.11.0/24",
        "AvailabilityZone": {"Fn::Select": [0, {"Fn::GetAZs": ""}]},
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-private-subnet-1"}]
      }
    },
    "PrivateSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {"Ref": "VPC"},
        "CidrBlock": "10.0.12.0/24",
        "AvailabilityZone": {"Fn::Select": [1, {"Fn::GetAZs": ""}]},
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-private-subnet-2"}]
      }
    },
    "NatGateway1EIP": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "AttachGateway",
      "Properties": {
        "Domain": "vpc",
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-nat-eip-1"}]
      }
    },
    "NatGateway2EIP": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "AttachGateway",
      "Properties": {
        "Domain": "vpc",
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-nat-eip-2"}]
      }
    },
    "NatGateway1": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {"Fn::GetAtt": ["NatGateway1EIP", "AllocationId"]},
        "SubnetId": {"Ref": "PublicSubnet1"},
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-nat-1"}]
      }
    },
    "NatGateway2": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {"Fn::GetAtt": ["NatGateway2EIP", "AllocationId"]},
        "SubnetId": {"Ref": "PublicSubnet2"},
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-nat-2"}]
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {"Ref": "VPC"},
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-public-rt"}]
      }
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "AttachGateway",
      "Properties": {
        "RouteTableId": {"Ref": "PublicRouteTable"},
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {"Ref": "InternetGateway"}
      }
    },
    "PublicSubnetRouteTableAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {"Ref": "PublicSubnet1"},
        "RouteTableId": {"Ref": "PublicRouteTable"}
      }
    },
    "PublicSubnetRouteTableAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {"Ref": "PublicSubnet2"},
        "RouteTableId": {"Ref": "PublicRouteTable"}
      }
    },
    "PrivateRouteTable1": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {"Ref": "VPC"},
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-private-rt-1"}]
      }
    },
    "PrivateRoute1": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {"Ref": "PrivateRouteTable1"},
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {"Ref": "NatGateway1"}
      }
    },
    "PrivateSubnetRouteTableAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {"Ref": "PrivateSubnet1"},
        "RouteTableId": {"Ref": "PrivateRouteTable1"}
      }
    },
    "PrivateRouteTable2": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {"Ref": "VPC"},
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-private-rt-2"}]
      }
    },
    "PrivateRoute2": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {"Ref": "PrivateRouteTable2"},
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {"Ref": "NatGateway2"}
      }
    },
    "PrivateSubnetRouteTableAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {"Ref": "PrivateSubnet2"},
        "RouteTableId": {"Ref": "PrivateRouteTable2"}
      }
    },
    "ALBSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Security group for ALB",
        "VpcId": {"Ref": "VPC"},
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-alb-sg"}]
      }
    },
    "ECSSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Security group for ECS tasks",
        "VpcId": {"Ref": "VPC"},
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3000,
            "ToPort": 3000,
            "SourceSecurityGroupId": {"Ref": "ALBSecurityGroup"}
          }
        ],
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-ecs-sg"}]
      }
    },
    "DBSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Security group for RDS instance",
        "VpcId": {"Ref": "VPC"},
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {"Ref": "ECSSecurityGroup"}
          }
        ],
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-db-sg"}]
      }
    },
    "DBSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Subnet group for RDS instance",
        "SubnetIds": [{"Ref": "PrivateSubnet1"}, {"Ref": "PrivateSubnet2"}],
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-db-subnet-group"}]
      }
    },
    "DBSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": {
          "Fn::Sub": "fyzz-chat-db-secret-${Environment}"
        },
        "Description": "Database credentials for Fyzz Chat",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\": \"fyzz_chat\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludeCharacters": "\"@/\\"
        },
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-db-secret"}]
      }
    },
    "RDSInstance": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Retain",
      "Properties": {
        "DBInstanceClass": {"Ref": "DBInstanceClass"},
        "AllocatedStorage": {"Ref": "DBAllocatedStorage"},
        "Engine": "postgres",
        "EngineVersion": "17.6",
        "DBInstanceIdentifier": {
          "Fn::Sub": "fyzz-chat-db-${Environment}"
        },
        "DBName": "fyzz_chat",
        "MasterUsername": {
          "Fn::Sub": "{{resolve:secretsmanager:${DBSecret}:SecretString:username}}"
        },
        "MasterUserPassword": {
          "Fn::Sub": "{{resolve:secretsmanager:${DBSecret}:SecretString:password}}"
        },
        "DBSubnetGroupName": {"Ref": "DBSubnetGroup"},
        "VPCSecurityGroups": [{"Ref": "DBSecurityGroup"}],
        "PubliclyAccessible": false,
        "StorageEncrypted": true,
        "BackupRetentionPeriod": 7,
        "MultiAZ": false,
        "DeletionProtection": true,
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-db"}]
      }
    },
    "ApplicationLoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": "fyzz-chat-alb",
        "Subnets": [{"Ref": "PublicSubnet1"}, {"Ref": "PublicSubnet2"}],
        "SecurityGroups": [{"Ref": "ALBSecurityGroup"}],
        "Tags": [{"Key": "Name", "Value": "fyzz-chat-alb"}]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": "fyzz-chat-tg",
        "Port": 3000,
        "Protocol": "HTTP",
        "VpcId": {"Ref": "VPC"},
        "TargetType": "ip",
        "HealthCheckEnabled": true,
        "HealthCheckPath": "/api/health",
        "HealthCheckProtocol": "HTTP",
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "HTTPListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "DefaultActions": {
          "Fn::If": [
            "HasCertificate",
            [
              {
                "Type": "redirect",
                "RedirectConfig": {
                  "Protocol": "HTTPS",
                  "Port": "443",
                  "StatusCode": "HTTP_301"
                }
              }
            ],
            [
              {
                "Type": "forward",
                "TargetGroupArn": {"Ref": "TargetGroup"}
              }
            ]
          ]
        },
        "LoadBalancerArn": {"Ref": "ApplicationLoadBalancer"},
        "Port": 80,
        "Protocol": "HTTP"
      }
    },
    "HTTPSListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Condition": "HasCertificate",
      "Properties": {
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {"Ref": "TargetGroup"}
          }
        ],
        "LoadBalancerArn": {"Ref": "ApplicationLoadBalancer"},
        "Port": 443,
        "Protocol": "HTTPS",
        "Certificates": [{"CertificateArn": {"Ref": "CertificateArn"}}]
      }
    },
    "ECSCluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "fyzz-chat-cluster",
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ]
      }
    },
    "CloudWatchLogsGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ecs/fyzz-chat",
        "RetentionInDays": 30
      }
    },
    "ECSTaskExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        ],
        "Policies": [
          {
            "PolicyName": "SecretsManagerAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {"Ref": "BetterAuthSecretArn"},
                    {"Ref": "OpenaiApiKeySecretArn"}
                  ]
                }
              ]
            }
          },
          {
            "PolicyName": "SSMParameterAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameters",
                    "ssm:GetParameter"
                  ],
                  "Resource": [
                    "arn:aws:ssm:eu-central-1:720490349122:*"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ECSTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "EC2InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceforEC2Role"
        ],
        "Policies": [
          {
            "PolicyName": "SSMParameterAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameters"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:ssm:${AWS::Region}::parameter/aws/service/ecs/optimized-ami/amazon-linux-2023/recommended/image_id"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "EC2InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [{"Ref": "EC2InstanceRole"}]
      }
    },
    "LaunchTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateName": "fyzz-chat-launch-template",
        "LaunchTemplateData": {
          "ImageId": {
            "Fn::Sub": "{{resolve:ssm:/aws/service/ecs/optimized-ami/amazon-linux-2023/recommended/image_id}}"
          },
          "InstanceType": {"Ref": "InstanceType"},
          "IamInstanceProfile": {
            "Arn": {"Fn::GetAtt": ["EC2InstanceProfile", "Arn"]}
          },
          "UserData": {
            "Fn::Base64": {
              "Fn::Sub": "#!/bin/bash\necho ECS_CLUSTER=${ECSCluster} >> /etc/ecs/ecs.config\necho ECS_AVAILABLE_LOGGING_DRIVERS='[\"json-file\",\"awslogs\"]' >> /etc/ecs/ecs.config\n"
            }
          },
          "SecurityGroupIds": [{"Ref": "ECSSecurityGroup"}],
          "TagSpecifications": [
            {
              "ResourceType": "instance",
              "Tags": [{"Key": "Name", "Value": "fyzz-chat-instance"}]
            }
          ]
        }
      }
    },
    "AutoScalingGroup": {
      "Type": "AWS::AutoScaling::AutoScalingGroup",
      "Properties": {
        "AutoScalingGroupName": "fyzz-chat-asg",
        "VPCZoneIdentifier": [{"Ref": "PrivateSubnet1"}, {"Ref": "PrivateSubnet2"}],
        "LaunchTemplate": {
          "LaunchTemplateId": {"Ref": "LaunchTemplate"},
          "Version": {"Fn::GetAtt": ["LaunchTemplate", "LatestVersionNumber"]}
        },
        "MinSize": {"Ref": "MinCapacity"},
        "MaxSize": {"Ref": "MaxCapacity"},
        "DesiredCapacity": {"Ref": "MinCapacity"},
        "Tags": [
          {
            "Key": "Name",
            "Value": "fyzz-chat-asg-instance",
            "PropagateAtLaunch": true
          }
        ]
      }
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "fyzz-chat",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["EC2"],
        "Cpu": {"Ref": "TaskCpu"},
        "Memory": {"Ref": "TaskMemory"},
        "ExecutionRoleArn": {"Fn::GetAtt": ["ECSTaskExecutionRole", "Arn"]},
        "TaskRoleArn": {"Fn::GetAtt": ["ECSTaskRole", "Arn"]},
        "ContainerDefinitions": [
          {
            "Name": "fyzz-chat",
            "Image": {"Ref": "ImageUri"},
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 3000,
                "HostPort": 3000,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "PORT",
                "Value": "3000"
              },
              {
                "Name": "HOSTNAME",
                "Value": "0.0.0.0"
              },
              {
                "Name": "ENVIRONMENT",
                "Value": {"Ref": "Environment"}
              },
              {
                "Name": "BETTER_AUTH_URL",
                "Value": {"Ref": "BetterAuthUrl"}
              },
              {
                "Name": "DATABASE_URL",
                "Value": {
                  "Fn::Sub": [
                    "postgresql://{{resolve:secretsmanager:${Secret}:SecretString:username}}:{{resolve:secretsmanager:${Secret}:SecretString:password}}@${Endpoint}:${Port}/fyzz_chat?pgbouncer=true&connect_timeout=15&sslmode=no-verify",
                    {
                      "Secret": {"Ref": "DBSecret"},
                      "Endpoint": {"Fn::GetAtt": ["RDSInstance", "Endpoint.Address"]},
                      "Port": {"Fn::GetAtt": ["RDSInstance", "Endpoint.Port"]}
                    }
                  ]
                }
              },
              {
                "Name": "DIRECT_DATABASE_URL",
                "Value": {
                  "Fn::Sub": [
                    "postgresql://{{resolve:secretsmanager:${Secret}:SecretString:username}}:{{resolve:secretsmanager:${Secret}:SecretString:password}}@${Endpoint}:${Port}/fyzz_chat?connect_timeout=15&sslmode=no-verify",
                    {
                      "Secret": {"Ref": "DBSecret"},
                      "Endpoint": {"Fn::GetAtt": ["RDSInstance", "Endpoint.Address"]},
                      "Port": {"Fn::GetAtt": ["RDSInstance", "Endpoint.Port"]}
                    }
                  ]
                }
              }
            ],
            "Secrets": [
              {
                "Name": "BETTER_AUTH_SECRET",
                "ValueFrom": {
                  "Ref": "BetterAuthSecretArn"
                }
              },
              {
                "Name": "OPENAI_API_KEY",
                "ValueFrom": {
                  "Ref": "OpenaiApiKeySecretArn"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {"Ref": "CloudWatchLogsGroup"},
                "awslogs-region": {"Ref": "AWS::Region"},
                "awslogs-stream-prefix": "ecs"
              }
            }
          }
        ]
      }
    },
    "MigrationTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "fyzz-chat-migration",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["EC2"],
        "Cpu": 256,
        "Memory": 512,
        "ExecutionRoleArn": {"Fn::GetAtt": ["ECSTaskExecutionRole", "Arn"]},
        "TaskRoleArn": {"Fn::GetAtt": ["ECSTaskRole", "Arn"]},
        "ContainerDefinitions": [
          {
            "Name": "fyzz-chat-migration",
            "Image": {
              "Fn::Sub": [
                "${ImageBase}:migrate-latest",
                {
                  "ImageBase": {
                    "Fn::Select": [
                      0,
                      {
                        "Fn::Split": [
                          ":",
                          {"Ref": "ImageUri"}
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            "Essential": true,
            "Environment": [
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "ENVIRONMENT",
                "Value": {"Ref": "Environment"}
              },
              {
                "Name": "DIRECT_DATABASE_URL",
                "Value": {
                  "Fn::Sub": [
                    "postgresql://{{resolve:secretsmanager:${Secret}:SecretString:username}}:{{resolve:secretsmanager:${Secret}:SecretString:password}}@${Endpoint}:${Port}/fyzz_chat?connect_timeout=15&sslmode=no-verify",
                    {
                      "Secret": {"Ref": "DBSecret"},
                      "Endpoint": {"Fn::GetAtt": ["RDSInstance", "Endpoint.Address"]},
                      "Port": {"Fn::GetAtt": ["RDSInstance", "Endpoint.Port"]}
                    }
                  ]
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {"Ref": "CloudWatchLogsGroup"},
                "awslogs-region": {"Ref": "AWS::Region"},
                "awslogs-stream-prefix": "migration"
              }
            }
          }
        ]
      }
    },
    "ECSService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": "HTTPListener",
      "Properties": {
        "ServiceName": "fyzz-chat-service",
        "Cluster": {"Ref": "ECSCluster"},
        "TaskDefinition": {"Ref": "TaskDefinition"},
        "DesiredCount": {"Ref": "DesiredTaskCount"},
        "LaunchType": "EC2",
        "LoadBalancers": [
          {
            "ContainerName": "fyzz-chat",
            "ContainerPort": 3000,
            "TargetGroupArn": {"Ref": "TargetGroup"}
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": [{"Ref": "PrivateSubnet1"}, {"Ref": "PrivateSubnet2"}],
            "SecurityGroups": [{"Ref": "ECSSecurityGroup"}]
          }
        },
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        }
      }
    },
    "ServiceScalingTarget": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MaxCapacity": 4,
        "MinCapacity": {"Ref": "DesiredTaskCount"},
        "ResourceId": {
          "Fn::Sub": "service/${ECSCluster}/${ECSService.Name}"
        },
        "RoleARN": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService"
        },
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs"
      }
    },
    "ServiceScalingPolicy": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": "fyzz-chat-scaling-policy",
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {"Ref": "ServiceScalingTarget"},
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 70.0,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          },
          "ScaleOutCooldown": 300,
          "ScaleInCooldown": 300
        }
      }
    }
  },
  "Outputs": {
    "LoadBalancerDNS": {
      "Description": "DNS name of the load balancer",
      "Value": {"Fn::GetAtt": ["ApplicationLoadBalancer", "DNSName"]},
      "Export": {"Name": "fyzz-chat-alb-dns"}
    },
    "ECSClusterName": {
      "Description": "Name of the ECS cluster",
      "Value": {"Ref": "ECSCluster"},
      "Export": {"Name": "fyzz-chat-cluster-name"}
    },
    "ECSServiceName": {
      "Description": "Name of the ECS service",
      "Value": {"Fn::GetAtt": ["ECSService", "Name"]},
      "Export": {"Name": "fyzz-chat-service-name"}
    },
    "VpcId": {
      "Description": "VPC ID",
      "Value": {"Ref": "VPC"},
      "Export": {"Name": "fyzz-chat-vpc-id"}
    },
    "CloudWatchLogsGroup": {
      "Description": "CloudWatch Logs group",
      "Value": {"Ref": "CloudWatchLogsGroup"},
      "Export": {"Name": "fyzz-chat-logs-group"}
    },
    "DBEndpoint": {
      "Description": "RDS instance endpoint",
      "Value": {"Fn::GetAtt": ["RDSInstance", "Endpoint.Address"]},
      "Export": {"Name": "fyzz-chat-db-endpoint"}
    },
    "DBSecretArn": {
      "Description": "Database credentials secret ARN",
      "Value": {"Ref": "DBSecret"},
      "Export": {"Name": "fyzz-chat-db-secret-arn"}
    },
    "MigrationTaskDefinitionArn": {
      "Description": "ARN of the migration task definition",
      "Value": {"Ref": "MigrationTaskDefinition"},
      "Export": {"Name": "fyzz-chat-migration-task-def"}
    },
    "NextSteps": {
      "Description": "Next steps after stack creation",
      "Value": "1. Wait for ALB and RDS to be healthy 2. Run database migrations using MigrationTaskDefinition 3. Point your domain to the ALB DNS name"
    }
  }
}
