{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .agents/hooks/check-write.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/type-check.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/test.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/knip.ts"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun run check-write:*)",
      "Bash(bun run type-check:*)",
      "Bash(bun run test:*)",
      "Bash(bun run knip:*)",
      "Bash(bun run build:*)",
      "Bash(bun check-write:*)",
      "Bash(bun type-check:*)",
      "Bash(bun test:*)",
      "Bash(bun knip:*)",
      "Bash(bun build:*)",
      "Bash(bunx biome check:*)",
      "Bash(bunx tsc --noEmit:*)"
    ]
  }
}
