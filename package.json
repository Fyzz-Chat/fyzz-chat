{
  "name": "fyzz-chat",
  "version": "0.44.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "scan": "REACT_SCAN=true next dev",
    "dev:email": "email dev --port 3001",
    "analyze": "ANALYZE=true next build --webpack",
    "build": "prisma generate && next build",
    "build:standalone": "prisma generate && EXPORT_MODE=standalone next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun tests/integration/run.ts",
    "lint-staged": "lint-staged",
    "format": "biome format",
    "format-write": "biome format --write",
    "lint": "biome lint",
    "lint-write": "biome lint --write",
    "check": "biome check",
    "check-write": "biome check --write",
    "knip": "knip-bun",
    "klint": "klint",
    "prepare": "husky",
    "update:patch": "ncu -u --target patch -p bun && bun i",
    "update:minor": "ncu -u --target minor -p bun && bun i",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bun run check"
    ]
  },
