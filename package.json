{
  "name": "fyzz-chat",
  "version": "0.16.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:email": "email dev --port 3001",
    "analyze": "ANALYZE=true next build --webpack",
    "build": "prisma generate && next build",
    "build:standalone": "prisma generate && EXPORT_MODE=standalone next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint-staged": "lint-staged",
    "format": "biome format ./src",
    "format-write": "biome format --write ./src",
    "lint": "biome lint ./src",
    "lint-write": "biome lint --write ./src",
    "check": "biome check ./src",
    "check-write": "biome check --write ./src",
    "prepare": "husky",
    "update:patch": "ncu -u --target patch -p bun && bun i",
    "update:minor": "ncu -u --target minor -p bun && bun i",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bun run check"
    ]
  },
