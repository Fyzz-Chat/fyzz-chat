// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/lib/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  // Better Auth tables
  id            String    @id @default(cuid()) @map("id")
  name          String
  email         String    @unique
  emailVerified Boolean?  @map("email_verified")
  image         String?   @map("image")
  sessions      Session[]
  accounts      Account[]

  // Deprecated columns
  password String? @map("password")

  // Custom columns
  subscription  String         @default("free")
  customerId    String?        @map("customer_id")
  freeMessages  Int            @default(10) @map("free_messages")
  memoryEnabled Boolean        @default(false) @map("memory_enabled")
  skillsEnabled Boolean        @default(false) @map("skills_enabled")
  displayName   String?        @map("display_name")
  agentName     String?        @map("agent_name")
  mcpServers    Json?          @map("mcp_servers")
  defaultModel  String?        @map("default_model")
  conversations Conversation[]
  projects      Project[]
  memories      Memory[]
  skills        Skill[]
  ratings       Rating[]
  apiKeys       ApiKey[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model Project {
  id            String         @id @default(uuid())
  name          String
  description   String?
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  memories      Memory[]
  skills        Skill[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("projects")
}

model Conversation {
  id            String         @id @default(uuid())
  title         String
  messages      Message[]
  shares        Share[]
  memories      Memory[]
  model         String
  locked        Boolean        @default(false)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String         @map("user_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  lastMessageAt DateTime       @default(now()) @map("last_message_at")
  branchedFrom  String?        @map("branched_from")
  parent        Conversation?  @relation("ConversationBranches", fields: [branchedFrom], references: [id], onDelete: SetNull)
  branches      Conversation[] @relation("ConversationBranches")
  projectId     String?        @map("project_id")
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([branchedFrom])
  @@index([projectId])
  @@index([userId, projectId, lastMessageAt])
  @@map("conversations")
}

enum MessageRole {
  system
  user
  assistant
}

enum MessageStatus {
  complete
  pending
  failed
}

model Message {
  id               String        @id @default(uuid())
  role             MessageRole
  parts            Json?
  metadata         Json          @default("{}")
  content          String?
  // TODO[SEQ_CUTOVER]: Make this required (Int) after prod backfill is fully complete.
  sequence         Int?
  promptTokens     Int?          @default(0) @map("prompt_tokens")
  completionTokens Int?          @default(0) @map("completion_tokens")
  status           MessageStatus @default(complete)
  externalId       String?       @map("external_id")
  failedReason     String?       @map("failed_reason")
  conversationId   String        @map("conversation_id")
  conversation     Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  shares           Share[]
  ratings          Rating[]
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
  @@index([conversationId, sequence])
  @@map("messages")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Share {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  messageId      String       @map("message_id")
  expiresAt      DateTime?    @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageId])
  @@map("shares")
}

model Rating {
  id             String   @id @default(uuid())
  value          Int
  messageId      String   @map("message_id")
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([messageId])
  @@index([userId, createdAt])
  @@map("ratings")
}

enum MemoryType {
  fact
  opinion
  learning
  context
  feedback
}

model Memory {
  id             String        @id @default(uuid())
  type           MemoryType    @default(fact)
  content        String
  confidence     Float?
  category       String?
  source         String?
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?       @map("project_id")
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([projectId])
  @@index([userId, type])
  @@index([userId, type, confidence])
  @@index([projectId, type])
  @@map("memories")
}

model Skill {
  id              String    @id @default(uuid())
  name            String
  description     String
  content         String
  enabled         Boolean   @default(true)
  lastActivatedAt DateTime? @map("last_activated_at")
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?   @map("project_id")
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId])
  @@index([projectId])
  @@index([userId, lastActivatedAt])
  @@map("skills")
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  prefix     String
  hash       String    @unique
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("api_keys")
}

// Better Auth tables
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique @map("token")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  providerId            String    @map("provider_id")
  accountId             String    @map("account_id")
  refreshToken          String?   @map("refresh_token")
  accessToken           String?   @map("access_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @map("scope")
  password              String?   @map("password")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String   @map("identifier")
  value      String   @map("value")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier, value])
  @@map("verifications")
}
