// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/lib/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  // Better Auth tables
  id            String    @id @default(cuid()) @map("id")
  name          String
  email         String    @unique
  emailVerified Boolean?  @map("email_verified")
  image         String?   @map("image")
  sessions      Session[]
  accounts      Account[]

  // Deprecated columns
  password String? @map("password")

  // Custom columns
  subscription  String         @default("free")
  customerId    String?        @map("customer_id")
  freeMessages  Int            @default(10) @map("free_messages")
  memory        String?
  memoryEnabled Boolean        @default(false) @map("memory_enabled")
  mcpServers    Json?          @map("mcp_servers")
  defaultModel  String?        @map("default_model")
  conversations Conversation[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model Conversation {
  id            String    @id @default(uuid())
  title         String
  messages      Message[]
  model         String
  locked        Boolean   @default(false)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String    @map("user_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastMessageAt DateTime  @default(now()) @map("last_message_at")

  @@index([userId])
  @@index([userId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@map("conversations")
}

enum MessageRole {
  system
  user
  assistant
}

model Message {
  id                 String       @id @default(uuid())
  role               MessageRole
  parts              Json?
  metadata           Json         @default("{}")
  content            String?
  promptTokens       Int?         @default(0) @map("prompt_tokens")
  completionTokens   Int?         @default(0) @map("completion_tokens")
  conversationId     String       @map("conversation_id")
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Better Auth tables
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique @map("token")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  providerId            String    @map("provider_id")
  accountId             String    @map("account_id")
  refreshToken          String?   @map("refresh_token")
  accessToken           String?   @map("access_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @map("scope")
  password              String?   @map("password")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String   @map("identifier")
  value      String   @map("value")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier, value])
  @@map("verifications")
}
